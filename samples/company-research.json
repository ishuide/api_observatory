          "dependency_type": "DOCUMENT_READ",
          "is_critical": true
        }
      ]
    },
    {
      "agent": "Evidence Synthesizer",
      "purpose": "Summarizes retrieved evidence with citations",
      "team": "Orchard Research",
      "dependencies": [
        {
          "name": "Orchard Inference",
          "dependency_type": "INFERENCE",
          "is_critical": true
        },
        {
          "name": "Orchard Paper Index",
          "dependency_type": "RETRIEVAL",
          "is_critical": false
        }
      ]
    },
    {
      "agent": "Research Publisher",
      "purpose": "Publishes approved summaries",
      "team": "Orchard Platform",
      "dependencies": [
        {
          "name": "Orchard Document Store",
          "dependency_type": "DOCUMENT_WRITE",
          "is_critical": true
        },
        {
          "name": "Orchard Job Queue",
          "dependency_type": "ASYNC_TASK",
          "is_critical": false
        }
      ]
    }
  ],
  "workflows": [
    {
      "name": "Research Brief Production",
      "team": "Orchard Research",
      "criticality_level": "HIGH",
      "description": "Discover, synthesize, and publish an evidence-backed brief.",
